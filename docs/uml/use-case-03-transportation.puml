@startuml
title Casos de Uso - Transporte
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
}

actor "Supervisor" as Supervisor

rectangle "Modulo de Transporte" {
  rectangle "Recursos" {
    usecase "Gestionar vehiculos" as UC1
    usecase "Filtrar vehiculos\npor placa o estado" as UC2
    usecase "Gestionar conductores" as UC3
    usecase "Filtrar conductor\npor licencia" as UC4
    usecase "Gestionar asistentes\nde transporte" as UC5
    usecase "Consultar asistente\npor documento" as UC6
  }

  rectangle "Rutas y paradas" {
    usecase "Gestionar paradas" as UC7
    usecase "Filtrar paradas\npor sector o ciudad" as UC8
    usecase "Gestionar rutas" as UC9
    usecase "Agregar, remover\nu ordenar paradas" as UC10
    usecase "Filtrar rutas\npor escuela o estado" as UC11
  }
}

UC1 -[hidden]down- UC2
UC2 -[hidden]down- UC3
UC3 -[hidden]down- UC4
UC4 -[hidden]down- UC5
UC5 -[hidden]down- UC6
UC7 -[hidden]down- UC8
UC8 -[hidden]down- UC9
UC9 -[hidden]down- UC10
UC10 -[hidden]down- UC11

Supervisor --> UC1
Supervisor --> UC2
Supervisor --> UC3
Supervisor --> UC4
Supervisor --> UC5
Supervisor --> UC6
Supervisor --> UC7
Supervisor --> UC8
Supervisor --> UC9
Supervisor --> UC10
Supervisor --> UC11

UC10 .> UC9 : <<include>>
UC9 .> UC7 : <<include>>
@enduml
